# Copy this file to .env and edit the values:  cp .env.example .env
# .env holds passwords. Do not share it or commit it (it is already in .gitignore).
# Values given on the command line, such as  PORT=4000 npm start , always win over this file.
# Restart the server after editing.

# ---------- General ----------
ADMIN_PASSWORD=set-a-long-password-at-least-10-characters
# HTTPS_PORT=3443
# PORT=3000
# Address phones use to reach this server (QR codes and links). Needed when running in Docker,
# where the server cannot see this machine's address. Example: http://192.168.1.20:3000
# PUBLIC_URL=
# Docker only: the port on this machine (default 3000). Use the same port in PUBLIC_URL.
# HOST_PORT=3000

# ---------- Email vote codes (delete this section if you do not use email) ----------
# How to send: gmail | smtp | brevo
MAIL_PROVIDER=gmail

# Sender shown to recipients. With a name use 'Name <address>', and keep the ' quotes.
# Gmail/SMTP: optional, defaults to the signed-in account · Brevo: required, and must be a sender verified in Brevo
MAIL_FROM='Party Team <you@gmail.com>'

# --- Gmail (see "Using Gmail" in the README for creating an App Password) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD='abcd efgh ijkl mnop'

# --- Company SMTP (ask IT for these) ---
# SMTP_HOST=mail.company.com
# SMTP_PORT=587
# SMTP_USER=vote@company.com
# SMTP_PASS='password'
# SMTP_SECURE=false           # port 465 = true · 587 or 25 = false, and STARTTLS must then succeed (leave out to follow the port)
# Company-issued certificate: get the .pem file from IT and give its path (relative to this file's folder). Certificates are still checked every time.
# SMTP_CA_FILE=./company-ca.pem
# Passwords and email are only sent over an encrypted connection with a verified certificate. This cannot be turned off.
# (SMTP_ALLOW_SELF_SIGNED from earlier versions is retired and has no effect.)

# --- Brevo ---
# BREVO_API_KEY=xkeysib-xxxxxxxx

# Emails per day, used to warn the admin before sending (default: Gmail 500, Brevo 300, SMTP unlimited · 0 = no warning)
# Google Workspace accounts (company mail on Gmail) can send about 2000
# MAIL_DAILY_LIMIT=2000
