# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า:  cp .env.example .env
# ไฟล์ .env เก็บรหัสผ่าน อย่าส่งให้ใครหรือเอาขึ้น git (มีใน .gitignore แล้ว)
# ค่าที่พิมพ์หน้าคำสั่ง เช่น  PORT=4000 npm start  จะใช้แทนค่าในไฟล์นี้เสมอ
# แก้ไฟล์แล้วต้องรันเซิร์ฟเวอร์ใหม่

# ---------- ทั่วไป ----------
ADMIN_PASSWORD=ตั้งรหัสยาวๆอย่างน้อย10ตัว
# HTTPS_PORT=3443
# PORT=3000

# ---------- ส่งรหัสทางอีเมล (ไม่ใช้อีเมลก็ลบส่วนนี้ทิ้งได้) ----------
# เลือกวิธีส่ง: gmail | smtp | brevo
MAIL_PROVIDER=gmail

# ผู้ส่งที่ผู้รับเห็น ใส่ชื่อในรูป 'ชื่อ <อีเมล>' ต้องมีเครื่องหมาย ' ครอบ
# Gmail/SMTP: ไม่ใส่ก็ได้ ระบบใช้อีเมลของบัญชีที่ล็อกอิน · Brevo: ต้องใส่ และต้องเป็นอีเมลที่ยืนยันใน Brevo แล้ว
MAIL_FROM='ทีมงานปีใหม่ <you@gmail.com>'

# --- แบบ Gmail (ดูวิธีสร้าง App Password ใน README หัวข้อ "ใช้ Gmail") ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD='abcd efgh ijkl mnop'

# --- แบบ SMTP ของบริษัท (ขอค่าจากฝ่ายไอที) ---
# SMTP_HOST=mail.company.com
# SMTP_PORT=587
# SMTP_USER=vote@company.com
# SMTP_PASS='รหัสผ่าน'
# SMTP_SECURE=false           # พอร์ต 465 = true · 587 หรือ 25 = false แล้วต้องเข้ารหัสด้วย STARTTLS ได้ (ไม่ใส่ ระบบเดาจากพอร์ต)
# ใบรับรองที่บริษัทออกเอง: ขอไฟล์ .pem จากฝ่ายไอทีแล้วใส่ที่อยู่ไฟล์ (นับจากโฟลเดอร์ของไฟล์นี้) ระบบยังตรวจใบรับรองทุกครั้ง
# SMTP_CA_FILE=./company-ca.pem
# ระบบส่งรหัสผ่านและอีเมลเฉพาะบนการเชื่อมต่อที่เข้ารหัสและตรวจใบรับรองแล้วเท่านั้น ปิดไม่ได้
# (SMTP_ALLOW_SELF_SIGNED ของเวอร์ชันก่อนเลิกใช้แล้ว ใส่ไว้ก็ไม่มีผล)

# --- แบบ Brevo ---
# BREVO_API_KEY=xkeysib-xxxxxxxx

# จำนวนที่ส่งได้ต่อวัน ไว้เตือนแอดมินก่อนกดส่ง (ไม่ใส่ = Gmail 500, Brevo 300, SMTP ไม่จำกัด · 0 = ไม่เตือน)
# บัญชี Google Workspace (อีเมลบริษัทที่ใช้ Gmail) ส่งได้ราว 2000
# MAIL_DAILY_LIMIT=2000
